# Exemplo de configuração. Copie para .env e preencha com a SUA chave.
# O arquivo .env está no .gitignore e nunca deve ser enviado ao GitHub.
#
# A análise dos dados NÃO precisa de nenhuma chave: RAIS (FTP do MTE), IBGE e Ipeadata são abertos.
# A chave abaixo só é usada pelo script opcional extras/imagens.py (fotos de abertura do site).

OPENAI_API_KEY=sk-coloque-sua-chave-aqui
# PARIDADE_IMG_MODELO=gpt-image-2

# Caminhos opcionais (padrão: pastas dentro do repositório)
# PARIDADE_BRUTOS=/caminho/para/rais_7z
# PARIDADE_DADOS=/caminho/para/parquet
# PARIDADE_GEO=/caminho/para/geo
# PARIDADE_RESULTADOS=/caminho/para/resultados
